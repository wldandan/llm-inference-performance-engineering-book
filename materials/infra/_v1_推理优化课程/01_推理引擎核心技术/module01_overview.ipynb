    "ax1 = axes[0]\n",
    "prefill_time = 0.5  # 秒\n",
    "tokens_to_generate = 200\n",
    "decode_time_per_token = 0.03  # 秒/token\n",
    "total_decode_time = tokens_to_generate * decode_time_per_token\n",
    "\n",
    "ax1.barh(['推理时间线'], [prefill_time], color='#2196F3', label=f'Prefill ({prefill_time}s)')\n",
    "ax1.barh(['推理时间线'], [total_decode_time], left=prefill_time,\n",
    "         color='#FF5722', label=f'Decode ({total_decode_time}s, 生成{tokens_to_generate}个token)')\n",
    "\n",
    "ax1.set_xlabel('时间（秒）')\n",
    "ax1.set_title('时间分布：Decode占主导')\n",
    "ax1.legend()\n",
    "ax1.text(prefill_time/2, 0, f'Prefill\\n{prefill_time}s', ha='center', va='center', color='white', fontsize=10)\n",
    "ax1.text(prefill_time + total_decode_time/2, 0, f'Decode\\n{total_decode_time}s', ha='center', va='center', color='white', fontsize=10)\n",
    "\n",
    "# 右图：GPU利用率\n",
    "ax2 = axes[1]\n",
    "t = np.linspace(0, prefill_time + total_decode_time, 1000)\n",
    "gpu_util = np.where(t < prefill_time, 85 + np.random.normal(0, 3, len(t[t < prefill_time])),\n",
    "                     20 + np.random.normal(0, 3, len(t[t >= prefill_time])))\n",
    "\n",
    "# Simpler approach\n",
    "t_all = np.linspace(0, prefill_time + total_decode_time, 1000)\n",
