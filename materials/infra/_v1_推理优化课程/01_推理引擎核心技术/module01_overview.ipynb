    "bars1 = ax1.bar(x - width/2, unfused_io, width, label='未融合', color='#F44336', alpha=0.8, edgecolor='black')\n",
    "bars2 = ax1.bar(x + width/2, fused_io, width, label='融合后', color='#4CAF50', alpha=0.8, edgecolor='black')\n",
    "\n",
    "ax1.set_xlabel('算子类型')\n",
    "ax1.set_ylabel('HBM 读写次数')\n",
    "ax1.set_title('Transformer层中各算子的HBM I/O次数')\n",
    "ax1.set_xticks(x)\n",
    "ax1.set_xticklabels(operations, rotation=30, ha='right', fontsize=8)\n",
