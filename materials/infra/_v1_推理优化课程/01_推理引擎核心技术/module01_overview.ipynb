    "\n",
    "ax2.plot(t_all, gpu_util_all, color='#4CAF50', linewidth=1)\n",
    "ax2.axvline(x=prefill_time, color='red', linestyle='--', label='Prefill结束')\n",
    "ax2.fill_between(t_all, gpu_util_all, alpha=0.3, color='#4CAF50')\n",
    "ax2.axhline(y=85, color='blue', linestyle=':', alpha=0.5, label='Prefill平均利用率~85%')\n",
    "ax2.axhline(y=20, color='orange', linestyle=':', alpha=0.5, label='Decode平均利用率~20%')\n",
    "ax2.set_xlabel('时间（秒）')\n",
    "ax2.set_ylabel('GPU利用率 (%)')\n",
    "ax2.set_ylim(0, 100)\n",
    "ax2.set_title('GPU利用率：Decode阶段严重浪费')\n",
    "ax2.legend(fontsize=8)\n",
