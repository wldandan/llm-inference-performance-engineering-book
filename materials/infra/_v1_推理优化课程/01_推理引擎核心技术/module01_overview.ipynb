    "# 📊 Roofline模型：理解Compute-Bound vs Memory-Bound\n",
    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(10, 6))\n",
    "\n",
    "# GPU规格 (H100 SXM)\n",
    "peak_compute = 989    # TFLOPS (BF16)\n",
    "memory_bandwidth = 3.35  # TB/s\n",
    "ridge_point = peak_compute / memory_bandwidth  # Arithmetic Intensity at ridge point\n",
    "\n",
    "# Roofline曲线\n",
    "ai = np.logspace(-2, 4, 1000)  # Arithmetic Intensity (FLOPs/byte)\n",
    "performance = np.minimum(memory_bandwidth * ai, peak_compute)\n",
    "\n",
    "ax.loglog(ai, performance, 'b-', linewidth=3, label='H100 Roofline')\n",
    "ax.fill_between(ai, 0, performance, alpha=0.1, color='blue')\n",
    "\n",
    "# 标注操作点\n",
    "operations = {\n",
    "    'Decode (batch=1)': (0.1, 0.1 * memory_bandwidth, 'red', '▼'),\n",
    "    'Decode (batch=32)': (3, 3 * memory_bandwidth, 'orange', '▼'),\n",
    "    'Prefill (长序列)': (200, peak_compute, 'green', '★'),\n",
    "    'Dense GEMM (训练)': (500, peak_compute, 'purple', '★'),\n",
    "}\n",
    "\n",
    "for name, (x, y_expected, color, marker) in operations.items():\n",
    "    y_actual = min(memory_bandwidth * x, peak_compute)\n",
    "    ax.scatter(x, y_actual, s=200, color=color, zorder=5, marker='o')\n",
    "    ax.annotate(name, (x, y_actual), xytext=(x*1.5, y_actual*0.5),\n",
    "                fontsize=9, color=color,\n",
    "                arrowprops=dict(arrowstyle='->', color=color, lw=1.5))\n",
    "\n",
    "# 标注两个区域\n",
    "ax.axvline(x=ridge_point, color='gray', linestyle='--', alpha=0.7)\n",
    "ax.text(ridge_point*0.3, 100, 'Memory\\nBound\\n(带宽瓶颈)', fontsize=11,\n",
    "        ha='center', color='red', fontweight='bold')\n",
    "ax.text(ridge_point*3, 100, 'Compute\\nBound\\n(算力瓶颈)', fontsize=11,\n",
    "        ha='center', color='green', fontweight='bold')\n",
    "\n",
